{
  "rules": {
    ".read": false,
    ".write": false,
    "doctors": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "doctor_tokens": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('doctors').child(auth.uid).val() === true"
      }
    },
    "$patientId": {
      ".read": "$patientId.matches(/^patient[0-9]+$/) && auth != null && root.child('doctors').child(auth.uid).val() === true"
    }
  }
}
